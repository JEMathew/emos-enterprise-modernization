  "captions": [
    {
      "start": 0.0,
      "end": 4.62,
      "text": "How do you return to previous assessments while keeping workspace data separated?"
    },
    {
      "start": 5.14,
      "end": 8.94,
      "text": "Sign in to use the owner-bound workspace and its assessment history."
    },
    {
      "start": 9.255,
      "end": 14.715,
      "text": "EMOS uses authenticated access and owner-scoped Firestore rules for persisted user"
    },
    {
      "start": 14.715,
      "end": 15.375,
      "text": "records."
    },
    {
      "start": 15.375,
      "end": 19.955,
      "text": "Search assessment titles and content, filter the available history, and reopen a"
    },
    {
      "start": 19.955,
      "end": 22.895,
      "text": "prior decision to review its evidence and recommendation."
    },
    {
      "start": 23.735,
      "end": 26.295,
      "text": "History helps you examine previous work in context."
    },
    {
      "start": 26.61,
      "end": 31.330000000000002,
      "text": "Revisiting an assessment is not a fresh approval or evidence verification."
    },
    {
      "start": 32.39,
      "end": 37.61,
      "text": "Next, check whether its facts remain current, supply updated evidence where needed,"
    },
    {
      "start": 38.27,
      "end": 41.61,
      "text": "and follow the same readiness and human-governance checkpoints."
    }
  ],
