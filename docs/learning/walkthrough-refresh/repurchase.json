  "captions": [
    {
      "start": 0.0,
      "end": 2.18,
      "text": "When is buying a replacement the right path?"
    },
    {
      "start": 2.46,
      "end": 7.38,
      "text": "Repurchase means Replace and Adopt when evidence supports moving to a commercial"
    },
    {
      "start": 7.38,
      "end": 7.92,
      "text": "product."
    },
    {
      "start": 7.92,
      "end": 14.0,
      "text": "The playbook structures approval, replacement selection, configuration, data and user"
    },
    {
      "start": 14.0,
      "end": 19.6,
      "text": "migration, transition, retirement of the previous system, measurement, and learning."
    },
    {
      "start": 19.615,
      "end": 25.654999999999998,
      "text": "EMOS tracks the plan; it does not purchase software or migrate users automatically."
    },
    {
      "start": 25.654999999999998,
      "end": 31.715,
      "text": "Next, verify fit, compliance, data portability, and human approval before adoption."
    }
  ],
