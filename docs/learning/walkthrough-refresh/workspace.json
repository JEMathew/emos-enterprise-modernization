      "text": "Where should you begin?"
    },
    {
      "start": 1.38,
      "end": 4.04,
      "text": "Open EMOS and choose your workspace context."
    },
    {
      "start": 5.04,
      "end": 10.1,
      "text": "The Command Center summarizes the selected estate so you can identify workloads and"
    },
    {
      "start": 10.1,
      "end": 11.5,
      "text": "evidence that need attention."
    },
    {
      "start": 11.5,
      "end": 16.04,
      "text": "Use Understand to explore the portfolio and Enterprise DNA."
    },
    {
      "start": 16.62,
      "end": 20.62,
      "text": "Decide brings assessment and recommendations into focus."
    },
    {
      "start": 21.240000000000002,
      "end": 25.22,
      "text": "Governance remains a required checkpoint before approved transformation."
    },
    {
      "start": 25.22,
      "end": 27.64,
      "text": "Transform organizes the execution plan."
    },
    {
      "start": 27.654999999999998,
      "end": 31.595,
      "text": "Keep the same estate and workload context as you move between these areas."
    },
    {
      "start": 31.609999999999996,
      "end": 34.68999999999999,
      "text": "Sign in for the private, owner-bound workspace."
    },
    {
      "start": 35.709999999999994,
      "end": 40.849999999999994,
      "text": "Use the appearance control for light, dark, or system themes, and adapt the layout to"
    },
    {
      "start": 40.849999999999994,
      "end": 41.38999999999999,
      "text": "your screen."
    },
    {
      "start": 42.37,
      "end": 45.37,
      "text": "Next, select one workload and inspect its evidence."
    }
