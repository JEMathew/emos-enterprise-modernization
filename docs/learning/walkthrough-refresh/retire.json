    {
      "start": 0.0,
      "end": 2.16,
      "text": "When should a workload be removed?"
    },
    {
      "start": 2.84,
      "end": 7.06,
      "text": "Retire means Safely Decommission when verified evidence supports its removal."
    },
    {
      "start": 7.06,
      "end": 13.44,
      "text": "The playbook covers approval, consumer transition, archiving, decommissioning,"
    },
    {
      "start": 13.7,
      "end": 16.96,
      "text": "closure validation, measurement, and learning."
    },
    {
      "start": 16.96,
      "end": 22.28,
      "text": "EMOS tracks these checkpoints; it does not shut down production systems for you."
    },
    {
      "start": 22.28,
      "end": 28.86,
      "text": "Next, verify dependencies and retention requirements, obtain human approval, and"
    },
    {
      "start": 28.86,
      "end": 32.14,
      "text": "confirm accountable owners before decommissioning."
    }
  ],
