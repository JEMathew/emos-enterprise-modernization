    {
      "start": 0.0,
      "end": 3.14,
      "text": "When does the architecture itself need to change?"
    },
    {
      "start": 3.7,
      "end": 11.48,
      "text": "Refactor means Transform Architecture when the evidence justifies redesign."
    },
    {
      "start": 11.48,
      "end": 17.880000000000003,
      "text": "The playbook covers approval, decomposition, implementation, testing, transition,"
    },
    {
      "start": 18.18,
      "end": 21.12,
      "text": "stabilization, measurement, and learning."
    },
    {
      "start": 21.12,
      "end": 23.76,
      "text": "These stages organize governed delivery."
    },
    {
      "start": 24.14,
      "end": 28.28,
      "text": "EMOS does not autonomously rewrite or deploy your production application."
    },
    {
      "start": 28.28,
      "end": 35.36,
      "text": "Next, verify architectural drivers, dependencies, risks, and human approval, then"
    },
    {
      "start": 35.36,
      "end": 37.36,
      "text": "plan an incremental transition."
    }
  ],
